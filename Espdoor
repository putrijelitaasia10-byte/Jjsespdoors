local cfg = { enabled = true, showText = true, showHighlight = true, color = Color3.fromRGB(50, 150, 255) }
local trackedDoors = {} 
local espFolder = Instance.new("Folder")
espFolder.Name = "JJS_ESP_Objects"
espFolder.Parent = parent

local function updateESP(part)
    local data = trackedDoors[part]
    if not data then return end
    if data.Highlight then
        data.Highlight.Enabled = cfg.enabled and cfg.showHighlight
        data.Highlight.FillColor = cfg.color
    end
    if data.Billboard then
        data.Billboard.Enabled = cfg.enabled and cfg.showText
        local label = data.Billboard:FindFirstChildOfClass("TextLabel")
        if label then label.TextColor3 = cfg.color end
    end
end

local function addESP(part)
    if trackedDoors[part] then return end
    local hl = Instance.new("Highlight")
    hl.Adornee = part
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent = espFolder

    local bb = Instance.new("BillboardGui")
    bb.Adornee = part
    bb.Size = UDim2.new(0, 150, 0, 50)
    bb.StudsOffset = Vector3.new(0, 4, 0)
    bb.AlwaysOnTop = true
    bb.Parent = espFolder

    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Font = Enum.Font.GothamBold
    text.TextSize = 16
    text.TextStrokeTransparency = 0
    text.Parent = bb

    local conn = RunService.RenderStepped:Connect(function()
        if not part or not part.Parent or not espFolder.Parent then
            if hl then hl:Destroy() end
            if bb then bb:Destroy() end
            if conn then conn:Disconnect() end
            trackedDoors[part] = nil
            return
        end
        if cfg.enabled and cfg.showText then
            local dist = math.floor((Camera.CFrame.Position - part.Position).Magnitude)
            text.Text = string.format("Door\n[%d studs]", dist)
        end
    end)
    trackedDoors[part] = { Highlight = hl, Billboard = bb, RenderConn = conn }
    updateESP(part)
end

task.spawn(function()
    while espFolder.Parent do
        if cfg.enabled then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj.Name == "Door" then
                    local mainPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                    if mainPart and mainPart:IsA("BasePart") then 
                        addESP(mainPart) 
                    end
                end
            end
        end
        task.wait(1)
    end
end)

